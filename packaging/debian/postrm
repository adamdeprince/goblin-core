#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
if [ "$1" = purge ]; then
    deb-systemd-helper purge goblin-core.service >/dev/null
    deb-systemd-helper unmask goblin-core.service >/dev/null
fi
# Keep databases and the service account when removing or purging the package.
